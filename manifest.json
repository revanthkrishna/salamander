{
  "manifest_version": 3,
  "name": "salamander",
  "version": "2.0.0",
  "minimum_chrome_version": "105",
  "description": "select an area of any webpage, screenshot it, attach a note, and export for developers or ai agents to act on.",
  "permissions": ["storage", "scripting", "tabs", "unlimitedStorage", "downloads"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "dist/background.js"
  },
  "action": {
    "default_title": "salamander",
    "default_icon": {
      "16": "icons/logo-16x16.png",
      "48": "icons/logo-48x48.png",
      "128": "icons/logo-128x128.png"
    }
  },
  "icons": {
    "16": "icons/logo-16x16.png",
    "48": "icons/logo-48x48.png",
    "128": "icons/logo-128x128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/logo-button.svg", "icons/logo-button-black.svg", "fonts/*.woff2"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'none'; object-src 'none'; frame-src 'none'"
  }
}
